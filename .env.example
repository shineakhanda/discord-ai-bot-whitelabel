# ===== REQUIRED =====
DISCORD_TOKEN=
OWNER_ID=

# ===== AI (set at least one) =====
# Free Gemma 4 from Google AI Studio: aistudio.google.com/apikey
GOOGLE_AI_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it
# OpenRouter (backup / other models)
OPENROUTER_API_KEY=
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# numes.ai (optional)
NUMES_API_KEY=

# ===== optional =====
PREFIX=!
MEMBERS_INTENT=0
SERPER_API_KEY=
TAVILY_API_KEY=
OWNER_LOG_CHANNEL=
CHROME=1

# ===== registration / licence (optional) =====
# If set, this bot reports its own application ID, name and the servers it's in
# to this URL on startup and every few hours (see README "Registration"). A Discord
# webhook URL works and posts a readable message. Leave blank to disable.
REGISTER_URL=
REGISTER_INTERVAL_HOURS=6
